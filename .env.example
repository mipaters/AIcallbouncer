# Azure OpenAI (optional — enables "Connected Mode"; omit for Simulation Mode)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure Speech (optional — enables real transcription in the mic-simulation flow)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Real phone calls via Twilio (optional — see README §3)
AZURE_STORAGE_CONNECTION_STRING=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
